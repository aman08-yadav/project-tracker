# ══════════════════════════════════════════════════════════════
# ProjectHub — Environment Variables
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Database → Connect
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/project-tracker?retryWrites=true&w=majority

# ── Authentication ──────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_here

# ── Frontend URL (for CORS and email links) ────────────────
# Local: http://localhost:5001
# Render: https://your-service-name.onrender.com
CLIENT_URL=http://localhost:5001

# ── Email Notifications (Optional) ──────────────────────────
# Gmail:    SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587
# Generic:  Set your SMTP provider's host and port
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@projecthub.com

# ── File Upload ─────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Seed Script Passwords ───────────────────────────────────
DEFAULT_PASSWORD=student123
FACULTY_PASSWORD=faculty123
